# Text generation for policy summaries:
# groq -> Gemini -> raw retrieved text fallback is supported.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Gemini fallback / richer multimodal analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Multimodal image analysis:
# local = free local BLIP model
MULTIMODAL_PROVIDER=local
LOCAL_IMAGE_MODEL=Salesforce/blip-image-captioning-base

# Local embedding model for RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2

# App
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860